laravel-backend/bootstrap/cache/*.php
.phpunit.result.cache

# Archives & Temporary artifacts
*.zip
*.tar.gz
*.tgz
*.bak
*.tmp
lint_*.txt
eslint_report.txt

# OS metadata
.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
