node_modules/
frontend/node_modules/
vendor/
laravel-backend/vendor/

# Next.js build output
frontend/.next/
frontend/out/
out/
build/

# TypeScript build info
*.tsbuildinfo

# Laravel storage & cache
laravel-backend/storage/*.key
laravel-backend/storage/app/public/uploads/*
