# CAFÉ CUE & BREW — LARAVEL 11 PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env on Hostinger shared hosting and fill in live production values.

APP_NAME="Cafe Cue & Brew"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://api.cafecuebrew.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# HOSTINGER MYSQL DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Replace with actual Hostinger MySQL database credentials from hPanel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_cafecuebrew
DB_USERNAME=u123456789_admin
DB_PASSWORD=YOUR_HOSTINGER_DB_PASSWORD_HERE

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# FRONTEND INTEGRATION & SECURITY SECRETS
# -----------------------------------------------------------------------------
# Replace with live frontend URL for CORS origin validation
FRONTEND_URL="https://cafecuebrew.com"

# High-entropy JWT signing key for staff authentication
JWT_SECRET=YOUR_HIGH_ENTROPY_JWT_SECRET_KEY_HERE
