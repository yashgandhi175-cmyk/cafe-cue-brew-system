<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Laravel API: /api/* -> laravel-backend/public/index.php
    RewriteRule ^api(?:/(.*))?$ laravel-backend/public/index.php [L,QSA]

    # 2. Next.js static bundles & assets (Serve directly without rewriting)
    RewriteRule ^_next/(.*)$ _next/$1 [L]

    # 3. Serve existing static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Serve directories with index.html (e.g. /dashboard/tables -> dashboard/tables/index.html)
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # 5. Fallback for clean HTML pages (e.g. /login -> login/index.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # 6. Root homepage
    RewriteRule ^$ index.html [L]
</IfModule>
