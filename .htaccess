<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Laravel API: /api/* -> laravel-backend/public/index.php
    RewriteRule ^api(?:/(.*))?$ laravel-backend/public/index.php [L,QSA]

    # 2. Next.js static bundles & assets (Serve directly)
    RewriteRule ^_next/(.*)$ _next/$1 [L]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Serve direct folder index (e.g. /dashboard/tables/ -> dashboard/tables/index.html)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # 4. Fallback to index.html for all Next.js client routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
