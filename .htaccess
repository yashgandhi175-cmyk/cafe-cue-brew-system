RewriteEngine On

# ==================================================
# Laravel API
# /api/* -> laravel-backend/public/index.php
# ==================================================

RewriteCond %{REQUEST_URI} ^/api(?:/|$)
RewriteRule ^api(?:/(.*))?$ laravel-backend/public/index.php [L,QSA]

# ==================================================
# Next.js Static Export
# ==================================================

# 1. Direct file in public_html (e.g. _next/..., favicon.ico)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Direct directory index in public_html (e.g. /dashboard -> /dashboard/index.html)
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# 3. Direct HTML file (e.g. /menu -> /menu.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 4. Fallback if placed inside frontend/out/
RewriteCond %{DOCUMENT_ROOT}/frontend/out/$1 -f
RewriteRule ^(.+)$ frontend/out/$1 [L]

RewriteCond %{DOCUMENT_ROOT}/frontend/out/$1/index.html -f
RewriteRule ^(.+?)/?$ frontend/out/$1/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/frontend/out/$1.html -f
RewriteRule ^(.+?)/?$ frontend/out/$1.html [L]

# Root page
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^$ index.html [L]

RewriteCond %{DOCUMENT_ROOT}/frontend/out/index.html -f
RewriteRule ^$ frontend/out/index.html [L]
