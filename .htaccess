DirectoryIndex index.html index.php
Options -Indexes +FollowSymLinks
RewriteEngine On

# ==================================================
# 1. Laravel API Routing (/api/*)
# ==================================================
RewriteCond %{REQUEST_URI} ^/api(?:/|$)
RewriteRule ^api(?:/(.*))?$ laravel-backend/public/index.php [L,QSA]

# ==================================================
# 2. Serve Existing Static Files & Next.js Bundles
# ==================================================
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ==================================================
# 3. Serve Directory HTML (e.g. /dashboard -> /dashboard/index.html)
# ==================================================
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# ==================================================
# 4. Fallback for Static HTML Pages (e.g. /menu -> /menu.html)
# ==================================================
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ==================================================
# 5. Fallback if assets reside in frontend/out/
# ==================================================
RewriteCond %{DOCUMENT_ROOT}/frontend/out/$1/index.html -f
RewriteRule ^(.+?)/?$ frontend/out/$1/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/frontend/out/$1.html -f
RewriteRule ^(.+?)/?$ frontend/out/$1.html [L]

RewriteCond %{DOCUMENT_ROOT}/frontend/out/$1 -f
RewriteRule ^(.+)$ frontend/out/$1 [L]
