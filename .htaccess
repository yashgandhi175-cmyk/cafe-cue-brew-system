DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# 1. Laravel API: /api/* -> laravel-backend/public/index.php
RewriteRule ^api(?:/(.*))?$ laravel-backend/public/index.php [L,QSA]

# 2. Next.js static bundles & assets (Serve directly)
RewriteRule ^_next/(.*)$ _next/$1 [L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. If directory, serve directory's index.html (e.g. /login -> /login/index.html, /dashboard -> /dashboard/index.html)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*)/?$ $1/index.html [L]

# 4. Fallback for clean HTML pages (e.g. /login -> /login.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. SPA Fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [L]
