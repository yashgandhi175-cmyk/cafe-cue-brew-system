<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Laravel API: /api/* -> laravel-backend/public/index.php
    RewriteRule ^api(?:/(.*))?$ laravel-backend/public/index.php [L,QSA]

    # 2. Serve static files directly (_next bundles, css, js, images, favicon)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Serve directories with index.html (e.g. /dashboard, /dashboard/tables, /login, /menu)
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # 4. Serve root homepage
    RewriteRule ^$ index.html [L]
</IfModule>
